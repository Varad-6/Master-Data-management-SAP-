{
  "_version": "1.85.0",
  "sap.app": {
    "id": "com.intapptics.zmdrbulkload",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.25.0",
      "toolsId": "e3d307ca-e06c-482f-a656-2a2ee2946412"
    },
    "crossNavigation": {
      "inbounds": {
        "zmdr_bulkupload-manage": {
          "semanticObject": "zmdr_bulkupload",
          "action": "manage",
          "title": "Bulk Upload",
          "subTitle": "Upload master data in a central location",
          "shortTitle": "Common Application - Do not launch directly",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },    
    "dataSources": {
      "mainService": {
        "uri": "mdrapi/bulk/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "adminService": {
        "uri": "mdrapi/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://upload",
      "favIcon": "sap-icon://upload",
      "phone": "sap-icon://upload",
      "phone@2": "sap-icon://upload",
      "tablet": "sap-icon://upload",
      "tablet@2": "sap-icon://upload"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.20",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.intapptics.zmdrbulkload.i18n.i18n",
          "supportedLocales": ["", "en", "en_US"],
          "fallbackLocale": ""
        }
      },
      "": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "adminModel": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "dataSource": "adminService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ],
      "js": [
        {
          "uri": "lib/xlsx.full.min.js"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.intapptics.zmdrbulkload.view",
        "async": true,
        "viewPath": "com.intapptics.zmdrbulkload.view"
      },
      "routes": [
        {
          "name": "main",
          "pattern": "",
          "target": [
            "main"
          ]
        }
      ],
      "targets": {
        "main": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "BulkLoad",
          "viewName": "BulkLoad"
        },
        "notFound": {
          "viewId": "notFound",
          "viewName": "NotFound",
          "transition": "show"
        }
      }
    },
    "rootView": {
      "viewName": "com.intapptics.zmdrbulkload.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "mdr.cap.btp"
  }
}
