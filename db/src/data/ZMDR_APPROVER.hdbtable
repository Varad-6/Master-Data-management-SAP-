-- db/src/data/ZMDR_APPROVER_DATA.hdbtable  (versioned table example)
COLUMN TABLE "ZMDR_APPROVER_DATA" (
  "APPROVER_LINEID"    INTEGER NOT NULL,
  "VERSION_START_DATE" TIMESTAMP NOT NULL,
  "APPROVER_ID"        NVARCHAR(12),
  "NODE_NAME"          NVARCHAR(30),
  "VERSION_ACTIVE"     NVARCHAR(1),
  "VERSION_END_DATE"   TIMESTAMP,
  "WORKFLOW_ID"        NVARCHAR(10),
  "CREATED_ON"         TIMESTAMP,  
  "CREATED_BY"         NVARCHAR(12),
  "UPDATED_ON"         TIMESTAMP,  
  "UPDATED_BY"         NVARCHAR(12),
  PRIMARY KEY ("APPROVER_LINEID", "VERSION_START_DATE")
)
